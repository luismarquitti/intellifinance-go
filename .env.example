# Local MVP: API + embedded dashboard + PostgreSQL. Redis and AI are not prerequisites.
# Copy to a private environment file; scripts/local-dev.sh loads it explicitly.
ENVIRONMENT=development
BIND_ADDR=127.0.0.1
PORT=8090

# Required private URL: use the NOSUPERUSER NOBYPASSRLS application role.
# Use a separate database for tests; never use the migration superuser at runtime.
DATABASE_URL=

# Synthetic Admin bypass: keep it inaccessible to untrusted networks.
DEV_ADMIN_EMAIL=admin@intellifinance.local
DEV_ADMIN_NAME='Synthetic Admin'
DEV_TENANT_NAME='Synthetic Household'
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8090,http://localhost:8090

# Optional Docker Compose infrastructure. Configure private credentials separately.
POSTGRES_USER=intellifinance
POSTGRES_PASSWORD=
POSTGRES_DB=intellifinance
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Later roadmap phases; not required to run the MVP.
PLUGGY_SANDBOX=true
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_WEBHOOK_SECRET=
