# Environment Configuration (development | production)
ENVIRONMENT=development
PORT=8080

# PostgreSQL Configuration
DATABASE_URL=postgres://intellifinance:dev_password_123@192.168.3.10:5432/intellifinance_dev?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# Redis / Asynq Configuration (Homelab)
REDIS_ADDR=192.168.3.10:6379
REDIS_PASSWORD=dev_secure_redis_password_123!

# Open Finance (Pluggy.ai)
PLUGGY_CLIENT_ID=mock_pluggy_client_id
PLUGGY_CLIENT_SECRET=mock_pluggy_client_secret
PLUGGY_WEBHOOK_SECRET=dev_webhook_hmac_secret_32_bytes_long!
PLUGGY_SANDBOX=true

# AI & LLM Engine
# Set to 'vertex' for GCP production or 'litellm' for Homelab dev
AI_PROVIDER=litellm
LITELLM_API_BASE=http://192.168.3.10:4000/v1
LITELLM_API_KEY=sk-mock-key
GCP_PROJECT_ID=mock-gcp-project-id
GCP_REGION=us-central1

# Storage Adapter (local | gcs)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads
GCS_BUCKET_NAME=mock-intellifinance-statements
