!test/fixtures/*.csv
!test/fixtures/*.ofx
!test/fixtures/*.json

# IDE & OS files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# Local database persistent volumes
postgres-data/
redis-data/
